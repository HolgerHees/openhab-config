component: svg
config:
  style:
    height: 100%
    width: 100%
    left: 0
  #preserveAspectRatio: xMidYMid slice
  tag: svg
  viewBox: 0 0 50 20
slots:
  default:
    - component: f7-row
      config:
        d: M 5 10 l 45 0
        fill: none
        id: pathLine
        stroke: "#999999"
        stroke-width: 2
        tag: path
        vector-effect: non-scaling-stroke
        visible: true
    - component: f7-row
      config:
        fill: "#BBBBBB"
        stroke: "#BBBBBB"
        d: M 0 -7.5 l 7 7 l -7 7
        stroke-width: 2
        tag: path
        vectorEffect: non-scaling-stroke
        visible: true
        style:
            overflow: visible
        #  transform: rotate(45deg)
      slots:
        default:
          - component: f7-row
            config:
              calcMode: linear
              dur: 3s
              repeatCount: indefinite
              tag: animateMotion
            slots:
              default:
                - component: f7-row
                  config:
                    tag: mpath
                    xlink:href: "#pathLine"
